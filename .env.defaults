# ==========================================
# Badminton Forum 開發環境預設設定
# ==========================================
# 使用方法：cp .env.defaults .env
# 然後根據需要修改設定值

# MariaDB 設定（開發環境預設值）
MARIADB_DATABASE=badmintonforumdb
MARIADB_USER=badmintonuser
MARIADB_PASSWORD=BadmintonPass123
MARIADB_ROOT_PASSWORD=rootpass123
DB_PORT=3306

# API 設定（開發環境預設值）
API_PORT=5246
JWT_SECRET=ThisIsAVerySecretKeyForJWTTokenGenerationPleaseChangeInProduction
JWT_ISSUER=BadmintonForumAPI
JWT_AUDIENCE=BadmintonForumClient
JWT_EXPIRATION_DAYS=7

# 前端設定
WEB_PORT=5173
VITE_API_URL=http://localhost:5246/api

# 部署設定（生產環境請修改）
# SERVER_IP: 設定為你的伺服器 IP 或域名
SERVER_IP=localhost
# ALLOWED_ORIGINS: API 允許的 CORS 來源，多個用逗號分隔
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# 預設管理員帳號（首次部署時自動創建）
# 生產環境請務必修改這些值！
DEFAULT_ADMIN_EMAIL=admin@badminton-forum.com
DEFAULT_ADMIN_PASSWORD=Admin123456!

# Google OAuth 設定（選用）
# 如需使用 Google 登入功能：
# 1. 前往 https://console.cloud.google.com/
# 2. 建立 OAuth 2.0 用戶端 ID
# 3. 將你的 Client ID 填入下方
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Vuestic Admin 後台設定
ADMIN_PORT=5174
ADMIN_APP_NAME=羽球論壇管理後台

# Adminer 設定（選用）
ADMINER_PORT=8080

# Email 服務設定
# 用於生成郵件中的連結（密碼重設、郵件驗證等）
# 生產環境請設定為實際的前端網址
EMAIL_BASE_URL=http://localhost:5173